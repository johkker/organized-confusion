{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/*.ts": {
            "memory": 1024,
            "maxDuration": 10,
            "runtime": "@vercel/node@4.0.0"
        }
    },
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "outputDirectory": "dist",
    "framework": "vite",
    "github": {
        "silent": true
    }
}